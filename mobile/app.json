{
  "expo": {
    "name": "LoomMitra",
    "slug": "loommitra-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "loommitra",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/images/icon.png",
    "android": {
      "package": "com.loommitra.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "LoomMitra needs photo access so weavers can add product photos.",
          "cameraPermission": "LoomMitra needs the camera so weavers can photograph their products."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aefa1dc1-7682-4472-91a8-3a2375634943"
      }
    }
  }
}
