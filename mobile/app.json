{
  "expo": {
    "name": "LoomMitra",
    "slug": "loommitra-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "loommitra",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.loommitra.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "LoomMitra needs photo access so weavers can add product photos.",
          "cameraPermission": "LoomMitra needs the camera so weavers can photograph their products."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
